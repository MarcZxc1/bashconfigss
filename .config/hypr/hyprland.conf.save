k# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua
general {
    gaps_in = 0
    gaps_out = 0
    border_size = 0
    # ... other settings
}

###################
### AUTOSTART   ###
###################

exec-once = hyprpaper                          # wallpaper daemon
exec-once = waybar                             # status bar
exec-once = dunst                              # notifications
exec-once = nm-applet                          # network tray icon

wallpaper = ~/.config/hypr/wallpaper.jpg

autogenerated = 0

$mainMod = SUPER
$terminal = alacritty
$fileManager = thunar
$menu = rofi -show drun

# Core Binds
bind = $mainMod, Q, exec, $terminal
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu

### 🪄 THE "MINIMIZE" FUNCTION (Special Workspace) ###
# Super + Shift + H throws the active window into the hidden void
bind = $mainMod SHIFT, H, movetoworkspacesilent, special:magic

# Super + H toggles the void, bringing your minimized apps onto the screen
bind = $mainMod, H, togglespecialworkspace, magic

### 🗂️ TASK VIEW / WINDOW SWITCHER ###
# Super + Tab triggers INSTANTLY on press. No ghosting, no delay.
bind = $mainMod, Tab, exec, pkill -x rofi || rofi -show window

### 🔄 CYCLE FOCUS (ALT-TAB) ###
bind = ALT, Tab, cyclenext,
bind = ALT SHIFT, Tab, cyclenext, prev

### ANIMATIONS ###
animations {
    enabled = false
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05
    # ... other default animations ...

    animation = specialWorkspace, 0, 1, default   # <--- Add it here!
}


### AUDIO CONTROLS ###
# Raise volume by 5%
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

# Lower volume by 5%
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# Toggle Mute
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

### TRADITIONAL DESKTOP (ZORIN) BEHAVIOR ###
# 1. Force ALL applications to open as floating windows instead of splitting
windowrule = float 1, match:class ^(.*)$

# 2. Make them open at a large, usable size (80% of your screen)
windowrule = size 80% 80%, match:class ^(.*)$

# 3. Always open new applications perfectly centered
windowrule = center 1, match:class ^(.*)$
