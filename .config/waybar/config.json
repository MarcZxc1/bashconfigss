{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "battery",
        "tray"
    ],
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "Click to adjust CPU Frequency\nModes: Battery Saving, Balance, Performance",
        "on-click": "~/.config/hypr/scripts/cpu_power.sh"
    },
    "memory": {
        "interval": 2,
        "states": {
            "warning": 75,
            "critical": 90
        },
        "format": "󰘚 {percentage}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "clock": {
        "interval": 10,
        "timezone": "Asia/Manila",
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰥔 {:%H:%M  󰃭 %Y-%m-%d}",
        "tooltip": false
    },
    "tray": {
        "spacing": 6
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "fixed-center": true,
    "mode": "dock",
    "exclusive": true
}
